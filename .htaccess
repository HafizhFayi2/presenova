Options -Indexes -MultiViews
DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let Let's Encrypt HTTP-01 challenge pass through without rewrites.
    RewriteRule ^\.well-known/acme-challenge/ - [L,NC]

    # Block hidden files and restricted runtime areas from direct web access.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule ^(face/(?:\.venv|faces_conf)|scripts|cron)(/|$) - [F,L,NC]

    # Block direct access to sensitive uploaded photos and runtime temp artifacts.
    RewriteRule ^uploads/(faces|attendance|temp)(/|$) - [F,L,NC]

    # Allow direct access for known static assets from project root URL.
    RewriteRule ^(assets|uploads|face)(/.*)?$ public/$1$2 [L,NC,QSA]
    RewriteRule ^(service-worker\.js|manifest\.json|robots\.txt|favicon\.ico)$ public/$1 [L,NC,QSA]
    # Canonicalize accidental /public/* URLs to app root path.
    RewriteRule ^public/?(.*)$ $1 [R=302,L,NC]

    # Force all dynamic URLs into Laravel front controller.
    RewriteRule ^ public/index.php [L,QSA]
</IfModule>
